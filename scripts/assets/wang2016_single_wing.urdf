<?xml version="1.0"?>
<robot name="wang2016_single_wing">
  <!-- Minimal 3-DoF kinematic chain to realize Wang2016 Euler angles:
       sweep (yaw about z), heave (roll about y), pitch (about x).

       Frame convention for the wing link:
         x: spanwise (pitch axis)
         y: surface normal
         z: chordwise (in wing plane)
  -->

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="sweep_link"/>
  <joint name="sweep" type="revolute">
    <parent link="base_link"/>
    <child link="sweep_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="5" velocity="50"/>
  </joint>

  <link name="heave_link"/>
  <joint name="heave" type="revolute">
    <parent link="sweep_link"/>
    <child link="heave_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5" velocity="50"/>
  </joint>

  <link name="wing">
    <inertial>
      <!-- Place COM roughly at mid-span; chordwise at pitch axis (z=0). -->
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
    <visual>
      <!-- Box approximating a thin plate: span=0.10m, chord=0.05m -->
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.002 0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.002 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="pitch" type="revolute">
    <parent link="heave_link"/>
    <child link="wing"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="5" velocity="50"/>
  </joint>
</robot>

